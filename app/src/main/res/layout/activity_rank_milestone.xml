<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#1C1F26"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->

        <!-- Spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="51dp"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:src="@drawable/arrow_4" />


            <TextView
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rank milestone"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <!-- Menu Icon pushed to far right -->

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- Bronze -->
        <LinearLayout
            android:id="@+id/bronzeLayout"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_bronze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Bronze Icon"
                android:src="@drawable/image_5" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="BRONZE"
                    android:textColor="#FF9933"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R2500 - R5000"
                    android:textColor="#FF9800"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Silver -->
        <LinearLayout
            android:id="@+id/silverLayout"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_silver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Silver Icon"
                android:src="@drawable/image_6" />

            <LinearLayout

                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="SILVER"
                    android:textColor="#C0C0C0"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R5000- R10000"
                    android:textColor="#A4A4A4"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gold -->
        <LinearLayout
            android:id="@+id/goldLayout"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Gold Icon"
                android:src="@drawable/image_7" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">


                <TextView
                    android:text="GOLD"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R10000 - R20000"
                    android:textColor="#FFEB3B"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Platinum -->
        <LinearLayout
            android:id="@+id/platinumLayout"
            android:padding="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_platinum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Platinum Icon"
                android:src="@drawable/image_8" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="PLATINUM"
                    android:textColor="#1E7CC7"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R20000 - R25000"
                    android:textColor="#2196F3"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
