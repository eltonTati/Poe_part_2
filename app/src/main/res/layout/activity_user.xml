<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1D2C"
    tools:context=".UserActivity">

    <!-- Hamburger Menu Button -->
    <ImageButton
        android:id="@+id/menu_button"
        android:layout_width="84dp"
        android:layout_height="71dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="3dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/menu"
        android:src="@drawable/ic_baseline_menu_24" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:layout_below="@id/menu_button"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/profile_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@string/profile_icon"
                android:src="@drawable/baseline_account_circle_24" />

            <!-- Profile Settings -->
            <TextView
                android:id="@+id/welcome_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/welcome_elton"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_profile_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00BCC4"
                android:drawableStart="@drawable/ic_settings"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawablePadding="12dp"
                android:padding="12dp"
                android:layout_marginTop="16dp" />

            <!-- Notifications -->

            <!-- Help & FAQ -->
            <Button
                android:id="@+id/btn_profile_settings2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00BCC4"
                android:drawableStart="@drawable/ic_settings"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawablePadding="12dp"
                android:padding="12dp"
                android:text="Notifications"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_faq"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00BCC4"
                android:drawableStart="@drawable/ic_help"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawablePadding="12dp"
                android:padding="12dp"
                android:layout_marginTop="12dp" />

            <!-- Contact Us -->
            <Button
                android:id="@+id/btn_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contact_us"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00BCC4"
                android:drawableStart="@drawable/ic_contact"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawablePadding="12dp"
                android:padding="12dp"
                android:layout_marginTop="12dp" />

            <!-- Sign Out -->
            <Button
                android:id="@+id/btn_sign_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_out"
                android:textAllCaps="true"
                android:backgroundTint="#777777"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_rounded"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/house"
                android:contentDescription="Home" />
        </FrameLayout>

        <ImageView
            android:id="@+id/navAnalysis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Analysis"
            android:src="@drawable/analitics" />

        <ImageView
            android:id="@+id/navTransactions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Transactions"
            android:src="@drawable/plus" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center">

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_cyan_circle" />

            <ImageView
                android:id="@+id/nav_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/profile"
                android:contentDescription="Home" />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
