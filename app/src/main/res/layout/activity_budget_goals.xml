<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E222B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back Arrow and Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backToWalletBtn"
                android:layout_width="45dp"
                android:layout_height="35dp"
                android:contentDescription="Back"
                android:src="@drawable/arrow_4" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY BUDGETS GOAL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"/>

        <!-- Dynamic RecyclerView for Budget Goals -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/budgetGoalsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

        <!-- Add New Budget Button -->
        <Button
            android:id="@+id/btn_add_budget_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD NEW BUDGET GOAL"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00ADB5"
            android:textColor="#FFFFFF"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
           />
    </LinearLayout>
</ScrollView>
