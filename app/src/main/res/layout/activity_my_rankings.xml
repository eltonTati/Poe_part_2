<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1D2C"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:paddingTop="30dp">

            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="44dp"
                android:layout_height="39dp"
                android:src="@drawable/back_arrow" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Rankings"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true" />

        </RelativeLayout>

        <!-- Progress -->
        <TextView
            android:id="@+id/percentage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You Are At 30% Of Your Expenses Goal"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="30"
            android:progressDrawable="@drawable/progressbar"
            android:scaleY="1.8" />

        <TextView
            android:id="@+id/current_saving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Saving: R1200"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/rank_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Rank: "
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/rank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bronze Planner"
            android:textColor="#FFA500"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/block_bronze"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_bronze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Bronze Icon"
                android:src="@drawable/image_5" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="BRONZE"
                    android:textColor="#FF9933"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R2500 - R5000"
                    android:textColor="#FF9800"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/next_milestone_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Milestone"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/arrow_after_bronze"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:src="@drawable/arrow_down"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/block_silver"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_silver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Silver Icon"
                android:src="@drawable/image_6" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="SILVER"
                    android:textColor="#C0C0C0"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R5000 - R10000"
                    android:textColor="#A4A4A4"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/arrow_after_silver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:src="@drawable/arrow_down"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/block_gold"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Gold Icon"
                android:src="@drawable/image_7" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="GOLD"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R10000 - R20000"
                    android:textColor="#FFEB3B"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/arrow_after_gold"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:src="@drawable/arrow_down"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/block_platinum"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_border_platinum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Platinum Icon"
                android:src="@drawable/image_8" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="PLATINUM"
                    android:textColor="#1E7CC7"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Saving amount: R20000 - R25000"
                    android:textColor="#2196F3"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Button -->
        <TextView
            android:id="@+id/SeeMilestone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="24dp"
            android:text="SEE RANKING MILESTONE →"
            android:textColor="#00BCC4"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
