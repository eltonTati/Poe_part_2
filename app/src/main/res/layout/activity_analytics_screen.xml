<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_analytics_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wisesaverbackground"
    tools:context=".AnalyticsScreenActivity">

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="169dp"
        android:layout_marginTop="39dp"
        android:text="Analytics"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="28dp"
        android:backgroundTint="@color/wisesaverbackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/side_menu_button" />

    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="291dp"
        android:layout_height="94dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="66dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/grey_rectangle_small" />

    <Button
        android:id="@+id/button"
        android:layout_width="107dp"
        android:layout_height="36dp"
        android:layout_marginStart="153dp"
        android:layout_marginTop="94dp"
        android:backgroundTint="@color/wisesaver_grey"
        android:text="Month"
        android:textAlignment="center"
        android:textColor="@color/wisesaverblue"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button2"
        android:layout_width="87dp"
        android:layout_height="35dp"
        android:layout_marginStart="67dp"
        android:layout_marginTop="94dp"
        android:backgroundTint="@color/wisesaver_grey"
        android:text="Day"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button3"
        android:layout_width="84dp"
        android:layout_height="37dp"
        android:layout_marginTop="94dp"
        android:layout_marginEnd="67dp"
        android:backgroundTint="@color/wisesaver_grey"
        android:text="Year"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView17"
        android:layout_width="364dp"
        android:layout_height="281dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="172dp"
