    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="382dp"
        android:layout_height="386dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="452dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/blue_rectangle" />

    <ImageView
        android:id="@+id/imageView19"
        android:layout_width="423dp"
        android:layout_height="141dp"
        android:layout_marginTop="628dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/navigation_rectangle" />

    <ImageButton
        android:id="@+id/home_button"
        android:layout_width="65dp"
        android:layout_height="54dp"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="7dp"
        android:backgroundTint="@color/wisesaver_navbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/house" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="66dp"
        android:layout_height="56dp"
        android:layout_marginEnd="122dp"
        android:layout_marginBottom="5dp"
        android:backgroundTint="@color/wisesaver_navbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/add_menu_button" />

    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="73dp"
        android:layout_height="64dp"
        android:layout_marginEnd="25dp"
        android:backgroundTint="@color/wisesaver_navbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/profile_page_button" />

    <ImageView
        android:id="@+id/imageView20"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/navbar_highlight" />

    <ImageView
        android:id="@+id/imageView21"
        android:layout_width="41dp"
        android:layout_height="33dp"
        android:layout_marginStart="136dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/analytics_page_button" />

    <ImageView
        android:id="@+id/imageView22"
        android:layout_width="379dp"
        android:layout_height="257dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="181dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bargraph_frame" />
</androidx.constraintlayout.widget.ConstraintLayout>